{
  "rules": {
    "devbook-ai": {
      "paths": [
        ".devbook/ai/**"
      ],
      "install": "ai"
    },
    "devbook-arc42": {
      "paths": [
        ".devbook/arc42/**"
      ],
      "install": "arc42"
    },
    "devbook-changes": {
      "paths": [
        "openspec/changes/**"
      ],
      "install": "changes"
    },
    "devbook-chapter-metadata": {
      "paths": [
        ".devbook/arc42/**",
        ".devbook/domain/**",
        ".devbook/tech/**",
        ".devbook/design/**",
        ".devbook/ai/**"
      ],
      "install": "always"
    },
    "devbook-design": {
      "paths": [
        ".devbook/design/**"
      ],
      "install": "design"
    },
    "devbook-domain": {
      "paths": [
        ".devbook/domain/**"
      ],
      "install": "domain"
    },
    "devbook-naming": {
      "paths": [
        ".devbook/arc42/**",
        ".devbook/domain/**",
        ".devbook/tech/**",
        ".devbook/design/**",
        ".devbook/ai/**",
        "**/_meta/**"
      ],
      "install": "always"
    },
    "devbook-tech": {
      "paths": [
        ".devbook/tech/**"
      ],
      "install": "tech"
    },
    "devbook-writing": {
      "paths": [
        ".devbook/arc42/**",
        ".devbook/domain/**",
        ".devbook/tech/**",
        ".devbook/design/**",
        ".devbook/ai/**"
      ],
      "install": "always"
    }
  }
}
