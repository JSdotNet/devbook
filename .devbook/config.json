          "from": "1.2.0",
          "hash": "sha256:5bd23466da7bf3e74e1bbef1ff051e5cfcfda2e118272e1a0f3af6a643c413f0",
          "managed": true
        }
      },
      "migrations": [
        { "id": "010-terms-live-in-domain-md", "applied": "2026-09-17" },
        { "id": "011-context-md", "applied": "2026-09-18" },
        { "id": "012-no-checkout-overlay", "applied": "2026-09-21" }
      ]
    },
    "derived": {
      "pluginVersion": "1.2.0",
