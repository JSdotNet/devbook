        "AGENTS.md#devbook": {
          "from": "1.0.0",
          "hash": "sha256:f6e1be423f6b4d91afd67e1cec9b7b23dbf4e1d0c6ac462e6873330c4ddaade4",
          "managed": true
        },
        ".gitignore#devbook": {
          "from": "1.0.0",
          "hash": "sha256:36b316a78cd232fc4f2a1d3248a2bc2449bbff9c9b5534b41f1aee9d8b2b2458",
          "managed": true
        }
      },
      "migrations": [
        { "id": "010-terms-live-in-domain-md", "applied": "2026-09-17" },
        { "id": "011-context-md", "applied": "2026-09-18" }
      ]
    },
    "derived": {
      "pluginVersion": "1.1.0",
      "materialized": {}
    },
    "devbook-procedures": {
      "pluginVersion": "1.2.0",
      "adopted": [],
