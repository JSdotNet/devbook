    },
    "delivery": {
      "pluginVersion": "1.2.0"
    },
    "schedule": {
      "pluginVersion": "1.2.0",
      "enabled": ["devbook-check", "tech-update", "merge-review", "package-update"]
    },
    "delivery-surface-dashboard": {
      "sessionNaming": {
        "labels": { "devbook": "devbook", "code": null }
      }
    }
  }
