{
  "id": "jsdotnet-devbook",
  "bindings": {
    "delivery.tracker": { "provider": "github" },
    "delivery.roles": {
      "architecture": null,
      "qa": null,
      "domain": null,
      "ux": null,
      "product": null,
      "security": null,
      "docs": null
    },
    "delivery.mcp": {
      "implement": null,
      "validate": null,
      "app.start": null,
      "qa.run": null
    }
  },
  "extensions": {
    "session.start": [
      "devbook:check"
    ],
    "app.start": null,
    "qa.run": null,
    "verify": "devbook:verify-change",
    "flow.end": [
      "devbook:install"
    ]
  },
  "policy": {
    "qa.depth": "skipped",
    "qa.ceiling": "skipped",
    "pr.required": false
  },
  "gates": [
    {
      "at": "deliver",
      "when": "before",
      "purpose": "approval",
      "prompt": "Nothing here is pushed or opened as a pull request until asked. Push and open one now?",
      "show": "summary",
      "unattended": "block"
    }
  ],
  "components": {
    "devbook": {
      "pluginVersion": "1.2.0",
